NODE_ENV=development
PORT=7002
MONGO_URI=mongodb://127.0.0.1:27017/admin_panel
JWT_SECRET_SUPER_ADMIN=change_me_super_admin_secret
JWT_SECRET_ADMIN=change_me_admin_secret
JWT_EXPIRES_IN=1d
CLIENT_CODE=default-client
# 3000 = admin panel (CRA), 4000 = public website (next dev -p 4000).
# Production origins, for reference (same-origin proxying means these are not
# currently exercised — see next.config.ts rewrites):
#   https://umaeng.co.in, https://admin.nventra.umaeng.co.in
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
# Number of proxy hops in front of express. In production there are TWO: the
# Vercel edge for the website project, then the Next.js rewrite into this
# project. Set too low, req.ip is the proxy address for every request and every
# rate limiter keys the whole internet into one bucket.
TRUST_PROXY=0
ENABLE_SEED=true
SUPER_ADMIN_SEED_PASSWORD=SuperAdmin@123
ADMIN_SEED_PASSWORD=Admin@123
API_KEY_HASH_SALT=replace_api_key_hash_salt
ENABLE_API_DOCS=true

# Payment (optional)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# File storage
# "supabase" is the deployed setting. "local" only works on a long-running
# process — the Vercel filesystem is read-only, and env.ts refuses to boot with
# STORAGE_BACKEND=local there rather than accepting uploads and losing them.
STORAGE_BACKEND=supabase
FILE_UPLOAD_DIR=uploads
FILE_UPLOAD_MAX_BYTES=52428800

# Supabase Storage — website images (and the file manager when
# STORAGE_BACKEND=supabase). The bucket is public to READ; only the service-role
# key can write to it, so the browser fetches images straight from the CDN and
# only this server can put them there.
#
# Set both or neither: env.ts rejects a half-configured pair, because one
# without the other silently falls back to local disk.
# Verify with: pnpm verify:storage
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio-uploads

# S3 (optional, when STORAGE_BACKEND=s3)
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# SMTP (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
